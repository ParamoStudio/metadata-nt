{
  "name": "metadata-nt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Offline desktop wrapper around the supplied upstream MAT2 metadata cleaner",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint:no-remote": "bash ../scripts/check-no-remote-refs.sh",
    "lint:ipc-surface": "bash ../scripts/check-ipc-surface.sh",
    "lint:no-html-sinks": "bash ../scripts/check-no-html-sinks.sh",
    "lint:all": "npm run lint:no-remote && npm run lint:ipc-surface && npm run lint:no-html-sinks",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "^5",
    "vite": "^7"
  }
}
